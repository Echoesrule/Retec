# Generate a random value for each deployment (for example: openssl rand -hex 32).
SECRET_KEY=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Use a shared Redis URL in production so limits work across all app workers.
RATELIMIT_STORAGE_URI=memory://

# Database
DATABASE_URL=sqlite:///portfolio.db
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=contact.retec@gmail.com

# Mailbox for responsible-disclosure reports on /security. Falls back to
# MAIL_TO when unset, so vulnerability reports always reach a monitored inbox.
SECURITY_CONTACT_EMAIL=


# Contact alerts are sent via Brevo with a cumulative enquiry CSV attached.
BREVO_API_KEY=
BREVO_LIST_ID=

# Unused: SMS alerts were replaced by the CSV-attachment email above.
SMS_NOTIFY_TO=
SMS_SENDER=RETEC


ZEROBOUNCE_API_KEY=

# RETEC Journal configuration
JOURNAL_SCHEDULER_ENABLED=false
JOURNAL_FETCH_INTERVAL_MINUTES=15
JOURNAL_MAX_DRAFTS_PER_SOURCE=5
JOURNAL_AI_ENABLED=false
JOURNAL_AI_API_KEY=
JOURNAL_AI_BASE_URL=https://api.openai.com/v1
JOURNAL_AI_MODEL=gpt-4o-mini
JOURNAL_AI_TEMPERATURE=0.2
JOURNAL_AI_TIMEOUT=45
JOURNAL_ADMIN_PER_PAGE=30
JOURNAL_PUBLIC_PER_PAGE=9
JOURNAL_FEATURED_MAX_AGE_DAYS=90
JOURNAL_SIMILARITY_THRESHOLD=0.42
JOURNAL_RECENT_SIMILAR_DAYS=30
JOURNAL_RECENT_SIMILAR_LIMIT=20
JOURNAL_FALLBACK_SITE_NAME=RETEC Journal
JOURNAL_PUBLISHER_NAME=RETEC
JOURNAL_PUBLISHER_LOGO=/static/images/logo.svg
JOURNAL_CANONICAL_BASE_URL=
JOURNAL_ALLOW_AI=false
JOURNAL_DEBUG=false
